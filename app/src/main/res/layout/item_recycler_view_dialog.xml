<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="3dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:visibility="gone"
        android:id="@+id/constraintCompanion"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/dateMessageCompanion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:text="@string/date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/messageCompanion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_marginTop="1dp"
            android:gravity="start|center_vertical"
            android:maxWidth="300dp"
            android:background="@drawable/style_message_recycler_dialog"
            android:padding="10dp"
            android:text="@string/testMessage"
            app:layout_constraintStart_toStartOf="@+id/dateMessageCompanion"
            app:layout_constraintTop_toBottomOf="@+id/dateMessageCompanion" />

        <ImageView
            android:id="@+id/selectCompanion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/messageCompanion"
            app:layout_constraintStart_toEndOf="@+id/messageCompanion"
            app:layout_constraintTop_toTopOf="@+id/messageCompanion"
            app:srcCompat="@drawable/drawable_icon_choose_element" />

        <ImageView
            android:id="@+id/selectCompanionImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/cardViewImageCompanionUser"
            android:layout_marginStart="10dp"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@+id/cardViewImageCompanionUser"
            app:layout_constraintTop_toTopOf="@+id/cardViewImageCompanionUser"
            app:srcCompat="@drawable/drawable_icon_choose_element" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardViewImageCompanionUser"
            android:layout_width="250dp"
            android:layout_height="300dp"
            android:visibility="gone"
            android:backgroundTint="@android:color/transparent"
            app:layout_constraintStart_toStartOf="@+id/dateMessageCompanion"
            app:layout_constraintTop_toBottomOf="@+id/dateMessageCompanion"
            app:strokeColor="@color/colorStart"
            app:strokeWidth="2dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressBarImageCompanion"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                app:indicatorColor="@color/statePressedIcon"
                app:indicatorSize="30sp"
                app:trackColor="@color/nameAppColor"
                app:trackThickness="3dp" />

            <ImageView
                android:id="@+id/imageCompanionUser"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                />

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintCurrent"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/dateMessageCurrentUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:text="@string/date"
            android:textColor="@color/black"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/messageCurrentUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="start|center_vertical"
            android:background="@drawable/style_message_recycler_dialog"
            android:padding="10dp"
            android:maxWidth="300dp"
            android:text="@string/testMessage"
            android:textColor="@color/black"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="@+id/dateMessageCurrentUser"
            app:layout_constraintTop_toBottomOf="@+id/dateMessageCurrentUser" />

        <ImageView
            android:id="@+id/selectCurrentUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/messageCurrentUser"
            android:layout_marginEnd="10dp"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/messageCurrentUser"
            app:layout_constraintTop_toTopOf="@+id/messageCurrentUser"
            app:srcCompat="@drawable/drawable_icon_choose_element" />

        <ImageView
            android:id="@+id/selectCurrentUserImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/cardViewImageCurrentUser"
            android:layout_marginEnd="10dp"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/cardViewImageCurrentUser"
            app:layout_constraintTop_toTopOf="@+id/cardViewImageCurrentUser"
            app:srcCompat="@drawable/drawable_icon_choose_element" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardViewImageCurrentUser"
            android:layout_width="250dp"
            android:layout_height="300dp"
            android:visibility="gone"
            android:backgroundTint="@android:color/transparent"
            app:layout_constraintEnd_toEndOf="@+id/dateMessageCurrentUser"
            app:layout_constraintTop_toBottomOf="@+id/dateMessageCurrentUser"
            app:strokeColor="@color/colorStart"
            app:strokeWidth="2dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressBarImageCurrent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                app:indicatorColor="@color/statePressedIcon"
                app:indicatorSize="30sp"
                app:trackColor="@color/nameAppColor"
                app:trackThickness="3dp" />

            <ImageView
                android:id="@+id/imageCurrentUser"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>